def checkExists(var,indir,region,ver,freq,dexper,exper_rip,predictor,start,end,suff,force):
	filedire = indir+"/../" #../../"+region+"/"+ver+"/"
	print "In checkExists()......"
	if "mask" in var: #spl cases are not great
		filedire = indir+"/../../" #../../"+region+"/"+ver+"/"
	print "-----Looking for PP output in:", filedire		
	filename =var+"_"+freq+"_"+dexper+"_"+exper_rip+"_"+region+"_"+start+"-"+end+".nc"
#	filename =var+"_"+freq+"_"+esdMethod+"_"+dexper+"_"+drip+"_"+region+"_"+predictor+"_"+start+"0101"+"-"+end+"1231"+".nc"
	if not os.path.exists(filedire+"/"+filename):			 
		exists = False  
	else:
		if (force == True):	
		print "CAUTION : PP output  already exists. But -f is turned on, so output will be overwritten"	
		exists = False
	else:
		exists = True
		print "\033[1;41mERROR: PP output already exists. ", filedire,"/",filename,". Please use -f option to override this. Quitting now..\033[1;m"
	return exists		

def call_ppFudge(basedire,indir,method,var,dexper,exper_rip,region,ver,lons,lone,lats,late,grid,freq,start,end,obsid,output_grid,ensarg,uinput,sbase):
	script1Loc = basedire+"/utils/pp/ppFudge" #"/main/code/esd/autogen/ppFudge"
	#CEW edits for email convenience
	total_exp_name = filter(None, sbase.split("/"))[-1] #The name of the experiment as a whole (not rip-split)
	out_split = indir.split("/")
	final_out_dir = '/'.join(map(str, out_split[0:out_split.index(region)+1])) #outdir
	print script1Loc 
	#check if output already exists
	#options basedir indir method var epoch rip region ver
	#TODO rem redundant region to cattool
	#	print "test", ensarg
	if (ensarg == "undefined") | (ensarg == None):
		fileprefix =var+"_"+freq+"_"+dexper+"_"+exper_rip+"_"+region+"_"+start+"-"+end 
	else:
		futexpername = exper_rip.split('_')[0]
		ensarg = futexpername+"_"+ensarg
		fileprefix = var+"_"+freq+"_"+dexper+"_"+ensarg+"_"+region+"_"+start+"-"+end 	
	cmd =  script1Loc+" "+basedire+" "+indir+" "+method+" "+var+" "+dexper+" "+exper_rip+" "+region+" "+ver+" "+str(lons)+" "+str(lone)+" "+str(lats)+" "+str(late)+" "+str(grid)+" "+fileprefix+" "+obsid+" "+output_grid
	print "PP ..in progress", cmd 
	#p = subprocess.Popen('tcsh -c "'+cmd+'"',shell=True,stdout=PIPE,stdin=PIPE, stderr=PIPE)
	p = subprocess.Popen('tcsh -f -c "'+cmd+'"',shell=True,stdout=subprocess.PIPE, stderr=subprocess.PIPE) 
	error,output = p.communicate()
	print p.returncode ,output, error
	word = "ERROR"
	fromEmail1 = os.environ["USER"] 
	if ( fromEmail1 == "esd" ): # ie you run from the role account
		fromEmail = "oar.gfdl.esd@noaa.gov"  
	else:
		fromEmail = fromEmail1+"@noaa.gov" #else use the current user's email id
	if(NEMSemail1 != "none"):
		try:
			uemail  = NEMSemail1 ## using cmd line arg in g release os.environ["NEMSemail"]
			send_to = uemail
		except KeyError:
			print "Please set the environment variable NEMSemail to receive email notifications about your FUDGE jobs "
			uemail = "na"
	else:
		uemail = "na"
	if (p.returncode != 0):
		print "\033[1;31m!!!! FAILED !!!!,error occured in call_ppFudge. Please save log and contact Aparna Radhakrishnan/Carolyn Whitlock'\033[1;m"
		subject = "fudge postProc failure for " + total_exp_name
		text = "An error occured in postProc suite of tools,call_ppFudge for experiment " + total_exp_name
		text = text + "\n\nThere may be one or more minfiles absent for the specified region."
		text = text + "\n\npostProc cannot be run at this time for "+var+"."
		text = text + "\n\nExperiment XML for reference-\n"+uinput
		text = text + "\n\nExperiment output directory: "+final_out_dir
		text = text + "\n\nMinifile logs: "+ sbase + "\log\out.*"
		text = text + "\n\nPostProc logs: "+ sbase + '\log\fudge_postProc.mfudge_postProc*'
		text = text + "\n\n--Please contact Aparna and Carolyn for help with the runs."
		notifyUser(send_to,subject,text)
		sys.exit(0)
	if word in error:
		print "'\033[1;31m!!!! FAILED. !!!!,error occured in call_ppFudge. Please save log and contact Aparna Radhakrishnan/Carolyn Whitlock\033[1;m"
		subject = "fudge postProc failure for " + total_exp_name
		text = "An error occured in postProc suite of tools,call_ppFudge for experiment " + total_exp_name
		text = text + "\n\nThere may be one or more minfiles absent for the specified region."
		text = text + "\n\npostProc cannot be run at this time for "+var+"."
		text = text + "\n\nExperiment XML for reference-\n"+uinput
		text = text + "\n\nExperiment output directory: "+final_out_dir
		text = text + "\n\nMinifile logs:"+ sbase + "/log/out.*"
		text = text + "\n\nPostProc logs: "+ sbase + '\log\fudge_postProc.mfudge_postProc*'
		text = text + "\n\n--Please contact Aparna and Carolyn for help with the runs."
