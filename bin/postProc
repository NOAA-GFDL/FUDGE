def checkExists(var,indir,region,ver,freq,dexper,exper_rip,predictor,start,end,suff,force):
	filedire = indir+"/../" #../../"+region+"/"+ver+"/"
	print "In checkExists()......"
	if "mask" in var: #spl cases are not great
		filedire = indir+"/../../" #../../"+region+"/"+ver+"/"
	print "-----Looking for PP output in:", filedire		
	filename =var+"_"+freq+"_"+dexper+"_"+exper_rip+"_"+region+"_"+start+"-"+end+".nc"
#	filename =var+"_"+freq+"_"+esdMethod+"_"+dexper+"_"+drip+"_"+region+"_"+predictor+"_"+start+"0101"+"-"+end+"1231"+".nc"
	if not os.path.exists(filedire+"/"+filename):			 
		exists = False  
	else:
		if (force == True):	
			print "CAUTION : PP output  already exists. But -f is turned on, so output will be overwritten"	
			exists = False
		else:
			exists = True
			print "\033[1;41mERROR: PP output already exists. ", filedire,"/",filename,". Please use -f option to override this. Quitting now..\033[1;m"
	return exists		

def call_ppFudge(basedire,indir,method,var,dexper,exper_rip,region,ver,lons,lone,lats,late,grid,freq,start,end,obsid,output_grid,ensarg,uinput,sbase):
	script1Loc = basedire+"/utils/pp/ppFudge" #"/main/code/esd/autogen/ppFudge"
	#CEW edits for email convenience
	total_exp_name = filter(None, sbase.split("/"))[-1] #The name of the experiment as a whole (not rip-split)
	out_split = indir.split("/")
	final_out_dir = '/'.join(map(str, out_split[0:out_split.index(region)+1])) #outdir
	print script1Loc 
	#check if output already exists
	#options basedir indir method var epoch rip region ver
	#TODO rem redundant region to cattool
	#	print "test", ensarg
	if (ensarg == "undefined") | (ensarg == None):
		fileprefix =var+"_"+freq+"_"+dexper+"_"+exper_rip+"_"+region+"_"+start+"-"+end 
	else:
		futexpername = exper_rip.split('_')[0]
		ensarg = futexpername+"_"+ensarg
		fileprefix = var+"_"+freq+"_"+dexper+"_"+ensarg+"_"+region+"_"+start+"-"+end 	
	cmd =  script1Loc+" "+basedire+" "+indir+" "+method+" "+var+" "+dexper+" "+exper_rip+" "+region+" "+ver+" "+str(lons)+" "+str(lone)+" "+str(lats)+" "+str(late)+" "+str(grid)+" "+fileprefix+" "+obsid+" "+output_grid
	print "PP ..in progress", cmd 
	p = subprocess.Popen("tcsh -f "+cmd,shell=True,stdout=PIPE,stdin=PIPE, stderr=PIPE,env=os.environ) #previously -c
	#p = subprocess.Popen('tcsh -c "'+cmd+'"',shell=True,stdout=subprocess.PIPE, stderr=subprocess.PIPE) 
	#p = subprocess.Popen('tcsh -f -c "'+cmd+'"',shell=True,stdout=subprocess.PIPE, stderr=subprocess.PIPE) 
	error,output = p.communicate()
	print p.returncode ,output, error
	word = "ERROR"
	if(NEMSemail1 != "none"):
		try:
			uemail  = NEMSemail1 ## using cmd line arg in g release os.environ["NEMSemail"]
			send_to = uemail
		except KeyError:
			print "Please set the environment variable NEMSemail to receive email notifications about your FUDGE jobs "
			uemail = "na"
			send_to = 'na'
	else:
		uemail = "na"
		send_to = 'na'
	if (p.returncode != 0):
		print "\033[1;31m!!!! FAILED !!!!,error occured in call_ppFudge. Please save log and contact Aparna Radhakrishnan/Carolyn Whitlock'\033[1;m"
		send_status_email("failure", 'postProc', total_exp_name, \
		                   traceback="One or more minifiles may be absent for the specified region", \
		                   mailid=send_to, logfiles = [os.path.join(sbase, "fudge_postProc.mfudge_postProc*")], \
		                   exp_info_file = os.path.join(sbase, 'experiment_info.txt'), \
		                   outfiles = final_out_dir, xml = uinput)			
		                   
		
		sys.exit(0)
	if word in error:
		print "'\033[1;31m!!!! FAILED. !!!!,error occured in call_ppFudge. Please save log and contact Aparna Radhakrishnan/Carolyn Whitlock\033[1;m"
		send_status_email("failure", 'postProc', total_exp_name, \
		                   traceback="One or more minifiles may be absent for the specified region", \
		                   mailid=send_to, logfiles = os.path.join(sbase, "log/fudge_postProc.mfudge_postProc*"), \
		                   exp_info_file = os.path.join(sbase, 'experiment_info.txt'), \
		                   outfiles = final_out_dir, xml = uinput)
		sys.exit(0)
############################################################################################
	global cnt
	global statmail
	cnt = cnt + 1
	print "1- completed\n"
	#CEW edit for email verbosity 6-30
	if statmail:
		send_status_email("success", 'postProc', total_exp_name, \
		                   mailid=send_to, logfiles = os.path.join(sbase, "log/out.*"), \
		                   exp_info_file = os.path.join(sbase, 'experiment_info.txt'), \
		                   outfiles = final_out_dir, xml = uinput)
	supp_strings = ['qcmask', 'save']
	if ("Anom" in var):
		#supp_match = [ for r in range(0, len(supp_string) if re.match() not None]
		if (supp_strings[0] not in var and supp_strings[1] not in var):
			print "Calling the anomaly addition script"
			anom_file = callAddAnom(final_out_dir, total_exp_name,var,send_to, sbase,uinput)
	return p.returncode
	
def callAddAnom(final_out_dir,exp_name,var,mailid=None,sbase="",uinput=""):
	#Figure out the final output in the output dir:
	out_files = [f for f in os.listdir(final_out_dir) if osp.isfile(osp.join(final_out_dir, f))]
	#If there is more that one file present, select the one with the shortest name
	anom_file = min(out_files, key=len)
	anom_file = osp.join(final_out_dir, anom_file)
	#Find the location for the clim + anom file
	clim_anom_file = re.sub('Anom','',anom_file)
	clim_anom_var = re.sub('Anom',"",var)
	with Dataset(anom_file, 'r') as nc_obj:
		try:
			clim = nc_obj.__dict__['climatology']
		except KeyError:
			clim_error = 'Climatology not found in input file ' + anom_file
			print("Error in anomaly addition! " + clim_error + " ;exiting")
			if( mailid is not None):
				send_status_email("failure", 'callAddAnom', total_exp_name, \
							traceback = clim_error,\
		                   mailid=mailid, logfiles = os.path.join(sbase, "log/out.*"), \
		                   exp_info_file = os.path.join(sbase, 'experiment_info.txt'), \
		                   outfiles = final_out_dir, xml = uinput)	
			exit(1)
			
	#Remove temporary directories from beginning of pathname, 
	#going as far as needed to complete
	clim_split = clim.split("/")
	s_idx = 0
	clim_exists = False
	while(s_idx < len(clim_split)):
		if(osp.exists("/".join(clim_split[s_idx:len(clim_split)]))):
			clim_exists = True
			clim_file = "/".join(clim_split[s_idx:len(clim_split)])
			break
		else:
			s_idx += 1		
	if(not clim_exists):
		clim_error = "Climatology file " + clim + ' not found on system'
		print ("Error in anomaly addition!" + clim_error + " ; exiting")
		if( mailid is not None):
			#send_anom_message('failure', clim_error, exp_name,mailid,
			#						anom_file,clim,"None",clim_err,"")
			send_status_email("failure", 'postProc', total_exp_name, \
			               traceback = "Climatology file " + clim + "not found on system",\
		                   mailid=send_to, logfiles = os.path.join(sbase, "log/out.*"), \
		                   #exp_info_file = os.path.join(sbase, 'experiment_info.txt'), \
		                   outfiles = final_out_dir)						
		exit(1)
	else:
		if( not osp.exists(osp.dirname(clim_anom_file)) ):
			print 'Making output anom + clim directory'
			os.makedirs(osp.dirname(clim_anom_file))	
		s8_path = os.environ.get("S8_PATH")
		#s8_path = "/home/cew/Code/section_8_tools/"
		#os.putenv("S8_PATH", s8_path)
		if (s8_path is None):
			print("Error in anomaly addition: $S8_PATH not set.")
		tdir = os.environ.get("TMPDIR")
		clim_anom_file_out = osp.join(tdir, clim_anom_file.lstrip("/"))
		if not osp.exists(osp.dirname(clim_anom_file_out)):
			os.makedirs(osp.dirname(clim_anom_file_out))
		clim_file_out = gcp(clim_file, 'TMPDIR')	
		anom_file_out = gcp(anom_file,'TMPDIR')	
		r_command = "Rscript " + s8_path + "/AddAnom.R --clim " + str(clim_file_out) + " --anom " + str(anom_file_out) + ' --var ' + str(clim_anom_var) + " -o " + str(clim_anom_file_out) + " --clone_globals"
		print "Calling AddAnom.R"
		try:
			p = subprocess.Popen(r_command,shell=True,stdout=subprocess.PIPE, stderr=subprocess.PIPE) 
		except: 
			print("Error in subprocess call of callAddAnom! Please examine call in more detail.")
			print(r_command)
			sys.exit(1)	
		error,output = p.communicate()
		#Check on what this returns with an R error
		print(error)
		print(output)
		if(p.returncode != 0):
			err_message = "error in call to AddAnom.R"
			print ("Error in anomaly addition! There was an " + err_message)
			print(r_command)
			if(mailid is not None):
				send_status_email("failure", 'postProc - anomAdd', exp_name, \
				           traceback = "Error in call to AddAnom.R - call for reference: " + r_command,\
		                   mailid=send_to, logfiles = os.path.join(sbase, "log/out.*"), \
		                   #exp_info_file = os.path.join(sbase, 'experiment_info.txt'), \
		                   outfiles = final_out_dir)
		else:
			print "Anomaly addition successful"
			##Replacing due to overly-thourough clone from climatology files
			#height_vars = ['tasmax', 'tasmin']
			#if (clim_anom_var in height_vars):
			#	print ("Adding height for " + clim_anom_var)
			#	print("ncks -A -h -v height "+clim_file_out + " " +clim_anom_file_out)
			#	p = subprocess.Popen("ncks -A -h -v height "+clim_file_out + " " +clim_anom_file_out,
			#			shell=True,stdout=subprocess.PIPE, stderr=subprocess.PIPE)
			#	p_out,p_err = p.communicate()
			#	print(p_out)
			#	print(p_err)		
			print "Copying to final location"			
			gcp(clim_anom_file_out, clim_anom_file)						
			#if(mailid is not None):
			#	send_anomadd_message('success',exp_name,mailid,
			#						anom_file,clim_file,clim_anom_file,
			#						err_message="",aux=r_command)						
	return clim_anom_file	

def send_anomadd_message(status,exp_name,mailid,
						anom_file,clim_file,clim_anom_file,
						err_message="",aux=""):
	#Helper function for sending messages from the anomaly addition code					
	sep = "\n\n"
	subject = "Fudge postProc anomaly addition"  + status + " for"  + exp_name
	if (err_message != ""):
		err_message = "due to " + err_message
	text = "Anomaly addition experienced a " + status + err_message + "."
	text = text + sep + "Anomaly input: " + anom_file
	text = text + sep + "Climatology input: " + clim_file
	text = text + sep + "Reconstructed output: " + clim_anom_file
	#text = text + sep + "Logfiles: " + anom_file	
	if (aux != ""):
		text = text + sep + aux		
	notifyUser(mailid,subject,text)	
	
	
def send_pp_message(status,step,exp_name,err, var,xml,outdir, minilog,pplog):
	#send a message about the pp status
	print "'\033[1;31m!!!! FAILED. !!!!,error occured in call_ppFudge. Please save log and contact Aparna Radhakrishnan/Carolyn Whitlock\033[1;m"
	subject = "fudge postProc failure for " + total_exp_name
	sep = "\n\n"
	#step='callPPFudge'
	text = "An error occured in postProc suite of tools," + step + " for experiment " + exp_name
	text = text + sep + err
	#text = text + "\n\nThere may be one or more minfiles absent for the specified region."
	text = text + sep + "postProc cannot be run at this time for "+var+"."
	text = text + sep + "\n\nExperiment XML for reference-\n"+xml
	text = text + sep + "\n\nExperiment output directory: "+outdir
	text = text + sep + "\n\nMinifile logs:"+ minilog
	text = text + sep + "\n\nPostProc logs: "+ pplog
	text = text + sep  + "\n\n--Please contact Aparna and Carolyn for help with the runs."
	notifyUser(mailid,subject,text)	
			 
def write_pp_status(loc, filename, status):
	newfile = loc + "/" + filename + "." + status
	f = open(newfile, 'aw')
	f.close() 			 
			 			 
