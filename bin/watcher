def parserWatcher():
     verbose = False #default
     debug = False
     traceback = False
     quiet = True	 
     timeout = None	
     sleeptime = None
     nloops = None
     mailid = None
     verbopt = 0		
     usage = "\n############################################################################\n"
     parser = OptionParser(usage)
     usage = usage + "Eg. watcher -i /home/a1r/cew/experiment_info.txt -t 5 \n"
     parser = OptionParser(usage)
     #v_print = None
     try:
        userinput
        uinput = userinput
     except:
         userinput = "none"
     parser.add_option("-i", "--file", dest="uinput",help="pass location of fudgeList out/experiment_info.txt" , metavar="FILE")
     parser.add_option("-m", "--mail", dest="mail",help="pass emailID to which notifications from FUDGE watcher should be sent to ")
     parser.add_option("-l", "--nloops", dest="nloops",help="pass number of times to loop through to check for output file generations (default: 72 )")
     parser.add_option("-s", "--sleeptime", dest="sleeptime",help="pass number of minutes to sleep between checks for output file presence (Default sleep time: 5 mins)")
     parser.add_option("-t", "--timeout_after_ppsubmission", dest="timeout",help="pass timeout in minutes (waits until t mins after ppscript is submitted and before quitting the tool (t>0)). (Default timeout: 0 minutes)")
     parser.add_option('-v', '--verbose',action="store_true",default=False,help="verbose output") 
     parser.add_option('-d', '--debug',action="store_true",default=False,help="print debug INFO")
     parser.add_option('--traceback',action="store_true",default=False,help="print traceback INFO,typically more info than debug")
     parser.add_option('--quiet',action="store_true",default=True,help="silent run, except for error reporting (True by default)" )
     (options, args) = parser.parse_args()
     for opts,vals in options.__dict__.items():
                if(opts == 'uinput'):
                         uinput = vals
                if(opts == 'timeout'):
		         if(timeout is not None): 
                         	timeout = (float)(vals)
                if(opts == 'verbose'):
		        if (vals == True):	
                        	verbose = vals
				sev = 1
		       	        verbopt = 1
                if(opts == 'debug'):
			if (vals == True):
                          	debug = vals
			  	sev = 2
                                verbopt = 1
                if(opts == 'traceback'):
		        if (vals == True):
                        	traceback = vals
				sev = 3	
                        	verbopt = 1
          #      if(opts == 'quiet'):
	#		if (vals == True):
         #               	quiet = vals
	#			sev = 0	
         #               	verbopt = 0 
		if(opts == 'sleeptime'):
				if (vals is not None):
		        		sleeptime = (float)(vals) * 60
	        if(opts == 'nloops'):
			nloops = vals
		if(opts == 'mail'):
			mailid = vals
     if (timeout is None):
	 timeout = 0.0	
     if (sleeptime is None):
	 sleeptime = 300.0
     if (nloops is None):
         nloops = 72	
     def _v_print(sev,verbmsg):
	 if(sev == 0) & (quiet == True):
	#we do nothing 
	        _v_print = lambda *a: None  # do-nothing function
         elif (sev == 1) & ((verbose == True) | (debug == True) | (traceback == True)):
	       print verbmsg 
	 elif (sev == 2) & ((debug == True) | (traceback == True)):
               print verbmsg
	 elif(sev == 3) & (traceback == True):	
               print verbmsg
     global v_print
     v_print = _v_print
     v_print(1,"experiment_info.txt: "+uinput)

     v_print(1,"Default timeout to quit"+ (str)(timeout)+" minute")
     runWatcher(uinput,timeout,verbopt,nloops,sleeptime,mailid)

def asciiParser(uinput):
	op = False #not yet spotted output_path
	spatmask = False
	#default to check NA #
	minifile_i_start = "undefined"
	minifile_i_end = "undefined"
	output_path = "undefined"
	spatmask = "undefined"
	script_base = "undefined"
	target = "undefined"
	qc_mask = "undefined"
				
	f = open(uinput, 'r')
	for line in f:
	    line = line.strip()
	    if(line.startswith('minifile.I.start:')):	
	        minifile_i_start = line.split('minifile.I.start:')[1]
            if(line.startswith('minifile.I.end:')):     
                minifile_i_end = line.split('minifile.I.end:')[1]
	    if(line.startswith('output.path:')):
		output_path = line
		op  = True
	    if(op == True) & (spatmask == False):
		if not ":" in line: 
		  output_path = output_path+","+line
            if(line.startswith('spat.mask.path_1:')):
                spatmask  = True
            if(line.startswith('script.base:')):
		script_base = line
	    if(line.startswith('target:')):
		target = line
	    if(line.startswith('qc.mask')):
	        qc_mask = line	
	f.close()
	if ((minifile_i_start == "undefined") | (minifile_i_end == "undefined") | (output_path == "undefined") | (spatmask == "undefined") | (script_base == "undefined") | (target == "undefined") | (qc_mask == "undefined")):
		print("\033[1;31m One of the fields from your input file is missing. Please check if minifile_i_start,minifile_i_end,output_path,spatmask,script.base,target,q.mask are all available in your input file. Program quitting now..\033[1;m")
		sys.exit(-18)
	return minifile_i_start,minifile_i_end,output_path,script_base,target,qc_mask

def runWatcher(uinput,timeout,verbopt,nloops,sleeptime,mailid):
	v_print(2,"INFO: SLEEP TIME:" +(str)(sleeptime)+"s")
	minifile_i_start,minifile_i_end,output_path,script_base,target,qc_mask = asciiParser(uinput)
	v_print(2, "INFO: parsed from input file -"+ minifile_i_start+"\n"+minifile_i_end+"\n"+output_path+"\n"+script_base) #debug 
	exp_cnt = int(minifile_i_end) - int(minifile_i_start) + 1 
	v_print(2,"INFO: Expected count "+ (str)(exp_cnt))
	dirs_output = output_path.split(':')[1]
	list_output = dirs_output.split(',')	
	qc_mask_bool = qc_mask.split(':')[1]
	target = target.split(':')[1]
	#will be nice to have target also in experiment_info.txt 
	ctr = 0 
	#based on status while loop through the following with sleep to check minifile existence
	#when checker is  a success msub the ppscript (even if one outpath is only complete at that time and wait for the rest, notify via email)
	#cretcode = 1 
        nloop_start = 0 
        for out in list_output:
	     retcode = 1
	     #TODO include retcode2 somehow in the following
             while ((retcode != 0) & (retcode != -13)): # | (len(list_output)!=0)) ) &( (retcode != -13))):
		v_print(1,"INFO: loop --"+(str)(nloop_start+1)) 
		v_print(3,"return after a loop"+(str)(retcode))
		v_print(2,"length of output.path"+(str)(len(list_output)))
	        v_print(2,"nloops"+"<="+(str)(nloop_start)) 
	        if ((int)(nloops) <= (int)(nloop_start)):
            		subject = "fudge notification- watcher/failure"
            		text = "Your watcher has timed out. postProc cannot be submitted at this time. \n\nExperiment_info.txt for reference-\n"+uinput
			text = text + "\n Please contact Aparna and Carolyn for assistance"
			notifyUser(mailid,subject,text)
		        sys.exit("Quitting watcher, max number of loops met "+(str)(nloops)+"<="+(str)(nloop_start))
		v_print(1, "checker to run on the file ") 
		retcode3 = checker.checker(out,exp_cnt,"warning",verbose=verbopt)
	        if (qc_mask_bool == 'on'):
			v_print(1, "qc_mask seems to be on, checker to run on qc_mask")
			outmask = out+"/"+target+"_qcmask"
			retcode2 = checker.checker(outmask,exp_cnt,"warning",verbose=verbopt)
		#print retcode
		        if (retcode3 == 0) & (retcode2 == 0):
		           v_print(1,"Both ds output and mask output seem to be available") 
			   #cprint "pop ", ctr
			  #com list_output.pop(ctr)
                           ctr = ctr - 1	
			   retcode = 0
			else:
                        	if(retcode2 != 0):
                         		 retcode = retcode2
				         v_print(2,"Mask file(s) to be assessed") 
                        	else:
                          		 retcode = retcode3
					 v_print(2,"DS output to be assessed")
			        v_print(2,"RETURN CODE "+ (str)(retcode))
		if(qc_mask_bool == 'off'):
		  if (retcode3 == 0):
		        retcode = 0 
			#clist_output.pop(ctr)
			ctr = ctr - 1 
		  else:
		          retcode = retcode3 
                ctr = ctr+1
		time.sleep(sleeptime)
		nloop_start = nloop_start + 1
	     #cnloop_start = nloop_start + 1  
	
        if (retcode == 0) | (len(list_output)==0):
	 v_print(1,"Running "+script_base+"/postProc/msubwrapper" +" for PP job submission")
	 script_base = script_base.split(':')[1]
         wscript = script_base+"/postProc/msubwrapper"	
         p = subprocess.Popen(wscript,shell=True,stdout=PIPE,stdin=PIPE, stderr=PIPE)
         output, errors = p.communicate()
         if(p.returncode != 0):
   	      v_print(1,"Step1:!!!! FAILED !!!!, please contact Aparna and Carolyn.")
         v_print(1,"INFO: job IDs"+ output)
         jobids =  output
	 v_print(2,"INFO:"+ errors)

	v_print(1,"time to quit program"+ (str)(timeout) +"mins")
        ppwaittime = timeout * 60
	time.sleep(ppwaittime) 
	if (retcode == - 13 ): #when mini.fail is out there 
            subject = "fudge notification- watcher/failed"
            text = "One or more batch jobs may have failed for this run. postProc cannot be run at this time. Experiment_info.txt for reference: "+uinput
	    text = text + "\n--Please contact Aparna and Carolyn for help with the runs."
	else:
	    print "jobs submitted"
            subject = "fudge notification- watcher/success"
            text = "Your postProc jobs have been submitted.\n\nExperiment_info.txt for reference-\n"+uinput
	    text = text + "\n\njob IDs for reference-\n"+ jobids
	    text = text + "\nPP scripts for reference-\n"+ wscript
	    notifyUser(mailid,subject,text)
def notifyUser(mailid,subject,text):
        # email header
        send_from = me # "aparna.radhakrishnan@noaa.gov"
        send_to = mailid
        msg = MIMEMultipart()
        msg['From'] = me #'aparna.radhakrishnan@noaa.gov' #todo change to esd
        msg['To'] = mailid
        msg['Date'] = formatdate(localtime=True) 
        msg['Subject'] = subject
	msg.attach( MIMEText(text))
        if (mailid is not None):
                smtp = smtplib.SMTP("localhost")
                smtp.sendmail(send_from, send_to, msg.as_string())
                smtp.close()	
if __name__ == '__main__':
   parserWatcher()
