# extract the ensemble portion of the RIP - the "r?to?" part - everything but the last 4 characters
# example = "r1to3"
set Rens=`echo $rip|awk '{ print substr(  $0, 1, length($0) - 4 ) }'`
if ($Rens =~ *to* ) then
  set ensBeg=`echo $Rens|awk '{ print substr(  $0, 2, 1) }'`
  set ensEnd=`echo $Rens|awk '{ print substr(  $0, 5, 1) }'`
else
  set ensBeg=`echo $Rens|awk '{ print substr(  $0, 2, 1) }'`
  set ensEnd=$ensBeg
endif

# extract the last 4 characters - the "i1p2" in this example
set IPsuffix=`echo $rip|awk '{ print substr(  $0, length($0) - 3, length($0) ) }'`

